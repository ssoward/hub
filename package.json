    "test:chess": "node activities/chess/smoke-test.mjs",
    "test:2048": "node activities/2048/smoke-test.mjs",
    "test:simon": "node activities/simon/smoke-test.mjs",
    "test:lights-out": "node activities/lights-out/smoke-test.mjs",
    "test:connect-four": "node activities/connect-four/smoke-test.mjs",
    "test:memory-match": "node activities/memory-match/smoke-test.mjs",
    "test:scoreboard": "node activities/scoreboard/smoke-test.mjs",
    "ham:build": "python3 ham-radio/tools/build_pools.py",
    "ham:validate": "python3 ham-radio/tools/validate_pools.py",
    "ham:test": "python3 ham-radio/tools/validate_pools.py && node ham-radio/tools/smoke-test.mjs"
  },
  "keywords": [
