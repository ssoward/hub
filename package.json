{
  "name": "hub",
  "version": "1.0.0",
  "description": "Gospel study, tech presentations, interactive activities, and conference schedules \u2014 a static site hub",
  "main": "index.html",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "build": "echo 'Static site - no build process needed'",
    "deploy": "echo 'Ready for static deployment to Vercel/Netlify'",
    "ham:build": "python3 ham-radio/tools/build_pools.py",
    "ham:validate": "python3 ham-radio/tools/validate_pools.py",
    "ham:test": "python3 ham-radio/tools/validate_pools.py && node ham-radio/tools/smoke-test.mjs",
    "scoreboard:test": "node activities/scoreboard/smoke-test.mjs"
  },
  "keywords": [
    "alma31",
    "book-of-mormon",
    "scripture-study",
    "lds",
    "church",
    "web-app",
    "pwa",
    "ham-radio",
    "amateur-radio",
    "flashcards"
  ],
  "author": "Church Study App",
  "license": "MIT",
  "homepage": "https://ssoward.github.io/hub/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ssoward/hub.git"
  }
}
